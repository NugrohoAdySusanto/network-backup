# ============================================================
# APPLICATION
# ============================================================
APP_NAME=Network Backup Dashboard
APP_ENV=development
APP_TIMEZONE=Asia/Jakarta
APP_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:8080
NGINX_PORT=8080
LOG_LEVEL=INFO

# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_DB=network_backup
POSTGRES_USER=network_backup
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://network_backup:replace-me@postgres:5432/network_backup

# ============================================================
# REDIS / SESSION
# DB 0 = Celery
# DB 1 = Server-side web session
# ============================================================
REDIS_URL=redis://redis:6379/0
SESSION_REDIS_URL=redis://redis:6379/1
SESSION_TTL_SECONDS=28800
REMEMBER_SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
SESSION_COOKIE_NAME=nb_session
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Bootstrap users are created manually with:
# docker compose run --rm api python -m app.cli.bootstrap_users
BOOTSTRAP_USERS_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_VIEWER_USERNAME=viewer
BOOTSTRAP_VIEWER_PASSWORD=

# ============================================================
# ZABBIX
# ============================================================
ZABBIX_URL=https://zabbix.example.internal
ZABBIX_API_TOKEN=replace-me
ZABBIX_NETWORK_GROUP_ID=replace-me
ZABBIX_AVAILABILITY_ITEM_KEY=icmpping
ZABBIX_SYNC_INTERVAL_SECONDS=30
ZABBIX_AVAILABILITY_MAX_AGE_SECONDS=120

# ============================================================
# NETWORK DEVICE SSH SERVICE ACCOUNT
# Shared read-only credential
# ============================================================
NETWORK_SSH_USERNAME=netbackup-ro
NETWORK_SSH_PASSWORD=replace-me
NETWORK_SSH_ENABLE_PASSWORD=replace-me
NETWORK_SSH_PORT=22
SSH_CONNECT_TIMEOUT_SECONDS=15
SSH_COMMAND_TIMEOUT_SECONDS=60

# For early lab development this may be false.
# Production target should be true after known_hosts is prepared.
SSH_STRICT_HOST_KEY_CHECKING=true
SSH_KNOWN_HOSTS_PATH=/app/known_hosts

# ============================================================
# CEPH S3 / RGW
# ============================================================
S3_ENDPOINT=https://ceph-rgw.example.internal:7443
S3_BUCKET=network-config-backup
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_SECURE=true

# ============================================================
# CEPH CLUSTER HEALTH
# Read-only Ceph Manager / Dashboard API credential
# ============================================================
CEPH_HEALTH_URL=https://ceph-manager.example.internal
# You can provide a static token OR provide username & password for auto-login / auto-refresh:
CEPH_HEALTH_TOKEN=
CEPH_HEALTH_USERNAME=
CEPH_HEALTH_PASSWORD=
CEPH_HEALTH_PINNED_FINGERPRINT=
CEPH_HEALTH_INTERVAL_SECONDS=30

# ============================================================
# FEISHU
# ============================================================
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me

# ============================================================
# SMTP / PASSWORD RESET
# ============================================================
SMTP_HOST=smtp.example.internal
SMTP_PORT=465
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=no-reply@example.internal
SMTP_TIMEOUT_SECONDS=10

# ============================================================
# BACKUP ENGINE
# ============================================================
BACKUP_MAX_ATTEMPTS=3
BACKUP_RETRY_DELAYS_SECONDS=30,120,300
BACKUP_WORKER_CONCURRENCY=3
BACKUP_LOCK_TTL_SECONDS=900
ENABLE_MOCK_DRIVER=false

# ============================================================
# SCHEDULER / RETENTION
# ============================================================
SCHEDULE_DISPATCH_INTERVAL_SECONDS=60
SCHEDULE_SLOT_MINUTES=5
RETENTION_RUN_HOUR=2
RETENTION_PURGE_GRACE_HOURS=24
